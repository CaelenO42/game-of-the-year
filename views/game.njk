<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <style>
        iframe {
            width: 50vw;
            height: auto;
            aspect-ratio: 16 / 9;
        }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.11/dist/htmx.min.js"
        integrity="sha384-2OatzQy1H+Zd/IIrjr1TcuDGqLXeHhbooAyJY1KdQMKnr4LZ22k31GBLdYKHmVjg"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/htmx-ext-sse@2.2.4"
        integrity="sha384-A986SAtodyH8eg8x8irJnYUk7i9inVQqYigD6qZ9evobksGNIXfeFvDwLSHcp31N"
        crossorigin="anonymous"></script>
    <script type="module" src="/js/confirm.js"></script>
</head>

<body hx-ext="sse" sse-connect="/game/{{ game.id }}/events">
    <p>{{ game.name }}</p>
    <p>{{ game.summary }}</p>
    <p>{{ game.total_review_count }}</p>
    <h3>Game Stats</h3>
    {% include "partials/game_stats.njk" %}
    <img src="https://images.igdb.com/igdb/image/upload/t_cover_big/{{ game.cover_image_id }}.jpg">
    {% if steam and steam.data %}
    <h3>Steam Info</h3>
    <p>Total Reviews: {{ steam.steam_reviews_total }}</p>
    <p>Positive Reviews: {{ steam.steam_reviews_positive }}</p>
    <p>Review Percentage: {{ (steam.steam_reviews_positive / steam.steam_reviews_total) * 100 }}</p>
    {% if steam.data.is_free %}
    <p>This game is free</p>
    {% endif %}
    {% if steam.data.metacritic %}
    <p>Metascore: {{ steam.data.metacritic.score }}</p>
    {% endif %}
    {% endif %}
    {% if user %}
    {% include "partials/user_game_controls.njk" %}
    {% include "partials/review_form.njk" %}
    {% else %}
    <a href="/login?next={{ ('/game/' + game.id) | urlencode }}">Log in to rate</a>
    {% endif %}
    <h3>User Reviews</h3>
    {% include "partials/review_list.njk" %}
    {% if twitch and twitch.streams %}
    <h3>Twitch Info</h3>
    <p>Viewers on top {{ twitch.streams.length }} streams: {{ twitch.total_viewers.toLocaleString('en-US') }}</p>
    {% for stream in twitch.streams.slice(0, 5) %}
    <iframe loading="lazy"
        src="https://player.twitch.tv/?channel={{ stream.user_login }}&parent={{ host | urlencode }}&autoplay={{ 'true' if loop.first else 'false' }}">
    </iframe>
    {% endfor %}
    {% endif %}
    {% include "partials/confirm_dialog.njk" %}
</body>

</html>