<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <style>
        iframe {
            width: 50vw;
            height: auto;
            aspect-ratio: 16 / 9;
        }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.11/dist/htmx.min.js"
        integrity="sha384-2OatzQy1H+Zd/IIrjr1TcuDGqLXeHhbooAyJY1KdQMKnr4LZ22k31GBLdYKHmVjg"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/htmx-ext-sse@2.2.4"
        integrity="sha384-A986SAtodyH8eg8x8irJnYUk7i9inVQqYigD6qZ9evobksGNIXfeFvDwLSHcp31N"
        crossorigin="anonymous"></script>
    <script type="module" src="/js/confirm.js"></script>
</head>

<body hx-ext="sse" sse-connect="/game/{{ game.id }}/events">
    <p>{{ game.name }}</p>
    <p>{{ game.total_review_count }}</p>
    <h3>Game Stats</h3>
    {% include "games/partials/game_stats.njk" %}
    {% if user %}
    {% include "games/partials/user_game_controls.njk" %}
    {% include "reviews/partials/review_form.njk" %}
    {% else %}
    <a href="/login?next={{ ('/game/' + game.id + '/reviews') | urlencode }}">Log in to rate</a>
    {% endif %}

    <h3>User Reviews</h3>
    <div id="review-items" hx-get="/game/{{ game.id }}-{{ game.name | slugify }}/reviews?p={{ page }}"
        hx-trigger="reviews-changed from:body" hx-select="#review-items" hx-swap="outerHTML">
        {% for review in reviews %}
        {% include "reviews/partials/review_item.njk" %}
        {% else %}
        <p>No reviews yet.</p>
        {% endfor %}
    </div>
    {% if totalPages > 1 %}
    <nav>
        {% if page > 1 %}<a href="/game/{{ game.id }}-{{ game.name | slugify }}/reviews?p={{ page - 1 }}">Previous</a>{% endif %}
        <span>Page {{ page }} of {{ totalPages }}</span>
        {% if page < totalPages %}<a href="/game/{{ game.id }}-{{ game.name | slugify }}/reviews?p={{ page + 1 }}">Next</a>{% endif %}
    </nav>
    {% endif %}
    {% include "shared/confirm_dialog.njk" %}
</body>

</html>