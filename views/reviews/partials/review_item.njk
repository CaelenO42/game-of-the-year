<article class="review">
    <header>
        <a href="/user/{{ review.username }}/game/{{ game.id }}-{{ game.name | slugify }}">{{ review.display_name or review.username }}</a>
        {% if review.rating !== null %}<span>{{ review.rating }}/100</span>{% endif %}
        <time datetime="{{ review.created_at.toISOString() }}" title="{{ review.created_at | fullDate }}">{{ review.created_at | timeAgo }}</time>
        {% if user.role === 'admin' and review.user_id !== user.id %}
            <button type="button" hx-delete="/admin/reviews/{{ review.id }}" hx-target="closest article" hx-swap="outerHTML" hx-confirm="Delete this review?">Delete</button>
        {% endif %}
    </header>

    {% if review.contains_spoilers %}
    <details>
        <summary>Contains spoilers</summary>
        <div style="white-space: pre-wrap">{{ review.body }}</div>
    </details>
    {% else %}
    <div style="white-space: pre-wrap">{{ review.body }}</div>
    {% endif %}
</article>