<form id="user-game-controls"
      hx-post="/game/{{ game.id }}/rating"
      hx-target="#user-game-controls"
      hx-swap="outerHTML">
  <label>
    Your rating
    <input type="number" name="rating" min="0" max="100" step="1"
           value="{% if userGame and userGame.rating !== null %}{{ userGame.rating }}{% endif %}">
  </label>
  <button type="submit">Rate</button>
</form>